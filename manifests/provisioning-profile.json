  "setup_policy": {
    "authorization": "Per operation; no blanket system_admin requirement or credential fallback",
    "errors": "401/403/429 retain types; no retry/redirect; post-send write transport failures and malformed successful setup writes are indeterminate",
    "identity": "Separate instance, credential and session pool from runtime Bot",
    "secrets": "SecretStr fields excluded from model repr/dump; setup responses do not retain raw/unknown payload fields",
    "boundary": "Low-level operations remain explicit; Bootstrap adds store-backed ownership, native permission checks, reconciliation and runtime-only handoff without exposing the setup client"
  },
  "bootstrap_policy": {
    "supported_versions": ["11.1.0", "11.7.0", "11.11.0", "12.0.2"],
    "ownership": "Matching names never prove ownership; owned and reused bindings have different mutation rights",
    "permissions": "Native role permission sets are read for the setup actor and runtime bot; no blanket system-admin requirement or runtime fallback",
    "features": "Fail closed on disabled/unobservable flags unless change_server_settings explicitly enables only the three provisioning flags",
    "recovery": "Durable intent precedes every write; conclusive 4xx responses abort, ambiguous outcomes block automatic retry until explicit reconciliation",
    "readiness": "Runtime identity/channel permissions are verified; callback registration never sets callback_verified"
  }
