  "reference_policy": "Pinned primary Go/TypeScript facts only; source is fetched to ignored build/, never executed or copied into the MIT package.",
  "native_events": {
    "dialog_submission": "DialogSubmission or DialogCancel according to the native cancelled boolean",
    "refresh": "DialogRefresh",
    "dialog_lookup": "DialogLookup",
    "dialog_action": "DialogAction, 11.11/12 profiles only"
  },
  "native_responses": {
    "submit": [
      "{}",
      "error string",
      "errors map",
      "type=form with managed form"
    ],
    "refresh": [
      "error string",
      "errors map",
      "type=form with managed form"
    ],
    "lookup": [
      "items array of text/value options"
    ],
    "cancel": [
      "{}"
    ],
    "action": [
      "{} after opening a child with its new native user trigger, or explicit ACK"
    ]
  },
  "wire_values": {
    "bool": "Actual boolean or explicit lowercase true/false compatibility strings, no Python truthiness.",
    "text_number_subtype": "Native client may send JSON number; domain text remains str, original retained. No invented numeric min/max/step.",
    "multiselect": "Native array of strings in all four referenced clients. CSV is a default format, not a generic submission parser.",
    "checkbox_matrix": "Native array of row:column1,column2 entries -> schema-checked mapping.",
    "date": "ISO date -> datetime.date; relative expressions not resolved in the bot timezone.",
    "datetime": "RFC3339 with offset -> aware datetime.",
    "file": "Native field string retained; confirmed top-level file_ids exposed separately without fabricated per-field association.",
    "missing_empty_false": "MISSING, null, empty string/array and false remain distinct; schema defaults never replace missing input.",
    "lookup_option_objects": "Only dialog_lookup context accepts exact label/value string objects (or arrays for multiselect), retaining raw input and validating value membership. Submission and refresh remain primitive-only."
  },
  "sessions": {
    "state": "mgd1.local-session-id.256-bit-random-capability; only SHA256 capability digest is accepted against the stored record. Not a fabricated platform dialog ID.",
    "binding": [
      "server/deployment",
      "bot",
      "authenticated user",
      "channel",
      "team",
      "callback ID",
      "form revision",
      "allowed form/action operation",
      "declared action field"
    ],
    "default_ttl_seconds": 900,
    "memory_capacity": 1024,
    "maximum_managed_steps": 32,
    "maximum_capability_history": 512,
    "nonterminal_response_cache": 16,
    "modal_depth": 3,
    "terminal_replay": "Stored final result returned without business re-execution while session record/capability remains valid.",
    "transport_callback_id": "Opening native callback ID stays stable through managed transitions. event.form.callback_id is the logical current declaration.",
    "opening_state_exception": "Revision-zero form capability may read current dynamic lookup fields or cancel the active session after transitions. Current schema, actor/scope/callback/operation/profile/TTL/status checks remain mandatory; stale submit/refresh/action writes stay rejected.",
    "refresh_prefill": "Compatible entered same-name/type values populate only implicit defaults, with explicit defaults including null/empty/false taking precedence. Recursive collapsible fields and explicit-field snapshot metadata preserve repeated edits; no per-field file association is invented.",
    "indeterminate": "Claim persisted before business dispatch. Timeout/cancellation/error after claim requires explicit application reconciliation; no automatic replay.",
    "limits": "Not an atomic transaction with business systems or fencing. Custom stores must provide bounded I/O and per-session isolation. Redis leases/record TTL/server clock assumptions remain explicit. Same config and stable shared backend are required across workers."
  },
  "ownership": "Adapter borrows manager unless own_dialogs=True. Manager owns only its default Memory store; provided stores are borrowed. RedisDialogStore.from_url owns its pool/isolation; constructor borrows.",
  "security": "Trusted transport peer is required before session verification. Raw form values, state capabilities and trigger IDs are excluded from normal event dumps/repr. Full wire access is explicit unsafe_raw(). Action application_context comes from the stored declaration, not arbitrary client context.",
  "real_evidence": "build/reports/forms-stand.json: API/actor-WS on 11.1. docs/reports/ui-web-12.0.2.json: recorded Windows Chrome 157 UI scenarios on 12.0.2. Other client profiles remain open in manifests/ui-client-profile.json.",
